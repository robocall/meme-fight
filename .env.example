# Copy to .env.local and fill in values. Never commit .env.local.

# --- Turso (database) ---
# Create a DB: https://docs.turso.tech/quickstart
# Then: turso db tokens create <db-name>
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Box (CCG — use on Vercel and locally) ---
# From https://app.box.com/developers/console → Configuration tab
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_ENTERPRISE_ID=

# Folder ID where meme images are stored (Service Account).
# Use "0" for the root folder, or create a folder in Box and paste its ID here.
BOX_MEMES_FOLDER_ID=0

# --- Local development only (optional) ---
# Short-lived token (~60 min). Ignored when all three CCG vars above are set.
# BOX_DEVELOPER_TOKEN=

# --- Reddit ingest (scripts/ingest-reddit.ts) ---
# Apify API token: https://console.apify.com/account/integrations
APIFY_TOKEN=

# Comma-separated subreddit names (no r/ prefix). Defaults: memes,dankmemes,me_irl
REDDIT_INGEST_SUBREDDITS=memes,dankmemes,me_irl

# hot | new | top
REDDIT_INGEST_SORT=hot

# Max posts per subreddit (1–100)
REDDIT_INGEST_MAX_ITEMS=50

# Skip posts below this upvote count
REDDIT_INGEST_MIN_SCORE=100
